# 腾讯云 COS 配置模板
# 使用方法：复制本文件为 config.env，然后填入真实值
# 注意：填好密钥的 config.env 只留本地，绝不要外传或打包

# 腾讯云账号 APPID（数字）
COS_APPID=your-appid

# 访问密钥（腾讯云控制台-访问管理-访问密钥中获取）
COS_SECRET_ID=your-secret-id
COS_SECRET_KEY=your-secret-key

# 存储桶名称（格式：bucket名-APPID，如 picgo-1302991947）
COS_BUCKET=your-bucket-name

# 地域（如 ap-guangzhou、ap-shanghai、ap-beijing）
COS_REGION=ap-guangzhou

# 论坛登录凭据（自动化发帖用；填好后的 config.env 仅留本地，勿外传/打包）
FORUM_USER=your-username
FORUM_PASS=your-password

# image=表格转图片（默认） / md=站点支持 md 表格时直发
TABLE_MODE=image
